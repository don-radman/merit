{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // TS7 removed baseUrl; paths must be relative to this file.
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "vite.config.ts"],
  // Generated bindings are their own npm package with their own pinned
  // @stellar/stellar-sdk. Build them in place:
  //   cd src/bindings/introducer-rails && npm install && npm run build
  "exclude": ["src/bindings/**"]
}
